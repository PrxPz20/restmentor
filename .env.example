# RestMentor Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# Database (Neon)
MASTER_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/restmentor_master?sslmode=require
TENANT_TEST_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/restmentor_tenant_test?sslmode=require

# Redis (will configure later)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# AI Engine
GEMINI_API_KEY=placeholder-get-key-later

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development